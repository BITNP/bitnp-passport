# 线上部署配置，本地开发请复制 dev/development.env。

# 本地构建的镜像名
BITNP_PASSPORT_IMAGE=bitnp-passport:local

APP_URL=https://accounts.example.com
DATABASE_URL=postgresql://bitnp:replace-me@postgres.example.com:5432/bitnp
LOG_LEVEL=info

# 公有读 S3 兼容桶（path-style）。未配置时头像上传不可用。
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=avatar

OIDC_ISSUER_URL=https://sso.example.com/realms/master
OIDC_CLIENT_ID=bitnp-passport
OIDC_CLIENT_SECRET=
KEYCLOAK_SERVICE_CLIENT_ID=bitnp-passport-service
KEYCLOAK_SERVICE_CLIENT_SECRET=

# Generate with: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64"))'
SESSION_ENCRYPTION_KEY=
