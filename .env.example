# 线上部署配置，本地开发请复制 dev/keycloak9.env 或 dev/keycloak26.env。

# 本地构建的镜像名
BITNP_PASS_IMAGE=bitnp-pass:local

APP_URL=https://accounts.example.com
DATABASE_URL=postgresql://bitnp:replace-me@postgres.example.com:5432/bitnp
LOG_LEVEL=info

KEYCLOAK_VERSION=9
OIDC_ISSUER_URL=https://sso.example.com/auth/realms/master
# KEYCLOAK_VERSION=26
# OIDC_ISSUER_URL=https://sso.example.com/realms/master
OIDC_CLIENT_ID=bitnp-pass
OIDC_CLIENT_SECRET=
KEYCLOAK_SERVICE_CLIENT_ID=bitnp-pass-service
KEYCLOAK_SERVICE_CLIENT_SECRET=

# Generate with: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64"))'
SESSION_ENCRYPTION_KEY=
ACTIVE_MEMBER_ROLE=bitnp-active
