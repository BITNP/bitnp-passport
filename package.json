{
  "name": "bitnp-passport",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "description": "BITNP Passport account portal",
  "engines": {
    "node": ">=24.12.0"
  },
  "imports": {
    "#backend/*": "./backend/*.ts",
    "#database/*": "./database/*.ts",
    "#shared/*": "./shared/*.ts"
  },
  "scripts": {
    "admin:bootstrap": "node --env-file-if-exists=.env scripts/bootstrap.ts",
    "build": "nuxt build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "dev": "nuxt dev --host 0.0.0.0",
    "dev:down": "docker compose -f compose.dev.yaml down",
    "dev:up": "docker compose -f compose.dev.yaml up -d --wait --wait-timeout 240",
    "format": "prettier . --write",
    "lint": "eslint . && prettier . --check",
    "lint:fix": "eslint . --fix && prettier . --write",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "worker": "node --env-file-if-exists=.env workers/index.ts"
  },
  "dependencies": {
    "@keycloak/keycloak-admin-client": "26.7.3",
    "drizzle-orm": "0.45.2",
    "h3": "1.15.11",
    "jose": "6.2.12",
    "naive-ui": "2.45.3",
    "nuxt": "4.5.2",
    "ofetch": "1.5.1",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "pino": "10.3.1",
    "vue": "3.5.42",
    "vue-router": "5.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@antfu/ni": "30.5.0",
    "@nuxt/eslint": "1.17.0",
    "@nuxtjs/color-mode": "4.0.1",
    "@so1ve/eslint-config": "4.7.0",
    "@so1ve/prettier-config": "4.7.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.16.tsgo.7.0.2",
    "unplugin-vue-components": "32.1.0",
    "vue-tsc": "3.3.11"
  }
}
